# Optional: enables richer AI-written resume feedback. The deterministic matcher works without this.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional: override or extend the default company board registry.
# JSON array example:
# JOB_BOARDS=[{"company":"Example","provider":"greenhouse","slug":"example","careersUrl":"https://example.com/careers"}]
JOB_BOARDS=
